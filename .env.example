# OpenRouter (modelos gratuitos com fallback automático)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_FALLBACK_MODELS=inclusionai/ling-3.2-flash:free,nvidia/nemotron-3.5-lightning:free,openrouter/free

# Banco em produção (opcional; vazio usa SQLite local backend/data/reviews.db)
DATABASE_URL=

# Langfuse v5 Observability & Feedback (opcional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Avaliações automatizadas DeepEval / busca vetorial (opcional)
GEMINI_API_KEY=
DISABLE_SEMANTIC_SEARCH=0

---
import Base from '../layouts/Base.astro';
import MobileBar from '../components/MobileBar.astro';
import Sidebar from '../components/Sidebar.astro';
import ContextBar from '../components/ContextBar.astro';
import { ChartsIsland } from '../components/react/ChartsIsland';
import { FindingsIsland } from '../components/react/ContextIsland';
import { MetricsIsland } from '../components/react/MetricsIsland';
import { ReviewsIsland } from '../components/react/ReviewsIsland';
import { ChatIsland } from '../components/react/ChatIsland';
import { LoadErrorIsland } from '../components/react/LoadErrorIsland';
---

<Base>
  <div class="flex min-h-screen w-full flex-col md:flex-row">
    <MobileBar />
    <Sidebar />

    <main id="dashboard-main" class="min-w-0 flex-1">
      <div class="stage mx-auto flex w-full max-w-[1320px] flex-col gap-8 px-6 py-6">
        <ContextBar />

        <LoadErrorIsland client:load />

        <section aria-labelledby="findings-heading" class="findings-band">
          <header class="findings-band-header">
            <h2 id="findings-heading" class="title">Achados do estudo</h2>
            <p class="meta findings-band-note">Base completa · não seguem o filtro</p>
          </header>
          <FindingsIsland client:load />
        </section>

        <MetricsIsland client:load />

        <ChartsIsland client:visible />

        <ReviewsIsland client:visible />
      </div>
    </main>
  </div>

  <!-- Começa fechado e a dica só aparece após ~10 s ocioso: hidrata depois das ilhas da carga inicial. -->
  <ChatIsland client:idle />

  <script>
    import '../scripts/dashboard';
  </script>
</Base>

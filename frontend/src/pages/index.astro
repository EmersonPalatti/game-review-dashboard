---
import Base from '../layouts/Base.astro';
import ComboToggle from '../components/ComboToggle.astro';
import RailIcon from '../components/RailIcon.astro';
---

<Base>
  <div class="flex min-h-screen w-full flex-col md:flex-row">
    <div class="sidebar-mobile-bar">
      <span class="mobile-wordmark">Reviews da Steam</span>
      <button
        id="sidebar-open"
        type="button"
        class="sidebar-burger"
        aria-expanded="false"
        aria-controls="app-sidebar"
        aria-label="Mostrar filtros"
      >
        <RailIcon>
          <path d="M4 5h16"></path>
          <path d="M4 12h16"></path>
          <path d="M4 19h16"></path>
        </RailIcon>
      </button>
    </div>
    <aside id="app-sidebar" class="sidebar sidebar-panel" aria-label="Filtros">
      <button id="sidebar-close" type="button" class="sidebar-close" aria-label="Fechar filtros">
        <RailIcon>
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </RailIcon>
      </button>
      <div class="sidebar-inner">
          <div class="sidebar-row is-logo">
            <div class="logo-mark" aria-hidden="true"></div>
            <div class="sidebar-reveal">
              <div class="sidebar-reveal-inner">
                <h1 class="wordmark">Reviews da Steam</h1>
                <p class="meta mt-1">Março de 2013<br />a janeiro de 2021</p>
              </div>
            </div>
          </div>

          <div class="mt-8 flex flex-col">
            <button id="theme-toggle" type="button" class="sidebar-row theme-toggle" aria-pressed="false" title="Alternar tema">
              <span class="when-light">
                <RailIcon>
                  <circle cx="12" cy="12" r="4"></circle>
                  <path d="M12 2v2"></path>
                  <path d="M12 20v2"></path>
                  <path d="m4.93 4.93 1.41 1.41"></path>
                  <path d="m17.66 17.66 1.41 1.41"></path>
                  <path d="M2 12h2"></path>
                  <path d="M20 12h2"></path>
                  <path d="m6.34 17.66-1.41 1.41"></path>
                  <path d="m19.07 4.93-1.41 1.41"></path>
                </RailIcon>
              </span>
              <span class="when-dark">
                <RailIcon>
                  <path
                    d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"
                  ></path>
                </RailIcon>
              </span>
              <span class="sidebar-reveal">
                <span class="sidebar-reveal-inner">
                  <span class="when-light">Escuro</span>
                  <span class="when-dark">Claro</span>
                </span>
              </span>
            </button>

            <form id="filters-form" class="mt-4 flex flex-col gap-2" autocomplete="off">
              <div class="filter-group">
                <label class="sidebar-row is-field" data-filter-row="app" title="Jogo">
                  <RailIcon>
                    <line x1="6" x2="10" y1="11" y2="11"></line>
                    <line x1="8" x2="8" y1="9" y2="13"></line>
                    <line x1="15" x2="15.01" y1="12" y2="12"></line>
                    <line x1="18" x2="18.01" y1="10" y2="10"></line>
                    <path
                      d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.545-.604-6.584-.685-7.258-.007-.05-.011-.1-.017-.151A4 4 0 0 0 17.32 5z"
                    ></path>
                  </RailIcon>
                  <span class="sidebar-reveal">
                    <span class="sidebar-reveal-inner field">
                      <span class="field-label">Jogo</span>
                      <div class="combo">
                        <input
                          id="filter-app"
                          class="field-control"
                          type="text"
                          role="combobox"
                          aria-autocomplete="list"
                          aria-expanded="false"
                          aria-controls="filter-app-list"
                          autocomplete="off"
                          spellcheck="false"
                          placeholder="Todos"
                        />
                        <ul id="filter-app-list" class="combo-menu" role="listbox"></ul>
                        <ComboToggle controls="filter-app-list" />
                      </div>
                    </span>
                  </span>
                </label>

                <label class="sidebar-row is-field" data-filter-row="language" title="Idioma">
                  <RailIcon>
                    <path d="m5 8 6 6"></path>
                    <path d="m4 14 6-6 2-3"></path>
                    <path d="M2 5h12"></path>
                    <path d="M7 2h1"></path>
                    <path d="m22 22-5-10-5 10"></path>
                    <path d="M14 18h6"></path>
                  </RailIcon>
                  <span class="sidebar-reveal">
                    <span class="sidebar-reveal-inner field">
                      <span class="field-label">Idioma</span>
                      <div class="combo">
                        <input
                          id="filter-language"
                          class="field-control"
                          type="text"
                          role="combobox"
                          aria-autocomplete="list"
                          aria-expanded="false"
                          aria-controls="filter-language-list"
                          autocomplete="off"
                          spellcheck="false"
                          placeholder="Todos"
                        />
                        <ul id="filter-language-list" class="combo-menu" role="listbox"></ul>
                        <ComboToggle controls="filter-language-list" />
                      </div>
                    </span>
                  </span>
                </label>

                <label class="sidebar-row is-field" data-filter-row="playtime" title="Tempo na avaliação">
                  <RailIcon>
                    <line x1="10" x2="14" y1="2" y2="2"></line>
                    <line x1="12" x2="15" y1="14" y2="11"></line>
                    <circle cx="12" cy="14" r="8"></circle>
                  </RailIcon>
                  <span class="sidebar-reveal">
                    <span class="sidebar-reveal-inner field">
                      <span class="field-label">Tempo na avaliação</span>
                      <div class="combo">
                        <input
                          id="filter-playtime"
                          class="field-control"
                          type="text"
                          role="combobox"
                          aria-autocomplete="list"
                          aria-expanded="false"
                          aria-controls="filter-playtime-list"
                          autocomplete="off"
                          spellcheck="false"
                          placeholder="Todos"
                        />
                        <ul id="filter-playtime-list" class="combo-menu" role="listbox"></ul>
                        <ComboToggle controls="filter-playtime-list" />
                      </div>
                    </span>
                  </span>
                </label>
              </div>

              <div class="filter-group">
                <div class="sidebar-row is-field" data-filter-row="recommended" title="Recomendação">
                  <RailIcon>
                    <path
                      d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"
                    ></path>
                    <path d="M7 10v12"></path>
                  </RailIcon>
                  <span class="sidebar-reveal">
                    <span class="sidebar-reveal-inner field">
                      <span class="field-label">Recomendação</span>
                      <div class="seg-control" role="group" aria-label="Recomendação">
                        <button type="button" class="seg-btn" data-tri-filter="recommended" data-tri-value="all" aria-pressed="true">Todas</button>
                        <button type="button" class="seg-btn" data-tri-filter="recommended" data-tri-value="yes" aria-pressed="false">Sim</button>
                        <button type="button" class="seg-btn" data-tri-filter="recommended" data-tri-value="no" aria-pressed="false">Não</button>
                      </div>
                    </span>
                  </span>
                </div>
              </div>

              <div class="filter-group">
                <div class="sidebar-row is-field" data-filter-row="steamPurchase" title="Compra na Steam">
                  <RailIcon>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                    <path d="M3.103 6.034h17.794"></path>
                    <path
                      d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z"
                    ></path>
                  </RailIcon>
                  <span class="sidebar-reveal">
                    <span class="sidebar-reveal-inner field">
                      <span class="field-label">Compra na Steam</span>
                      <div class="seg-control" role="group" aria-label="Compra na Steam">
                        <button type="button" class="seg-btn" data-tri-filter="steamPurchase" data-tri-value="all" aria-pressed="true">Todas</button>
                        <button type="button" class="seg-btn" data-tri-filter="steamPurchase" data-tri-value="yes" aria-pressed="false">Sim</button>
                        <button type="button" class="seg-btn" data-tri-filter="steamPurchase" data-tri-value="no" aria-pressed="false">Não</button>
                      </div>
                    </span>
                  </span>
                </div>

                <div class="sidebar-row is-field" data-filter-row="receivedForFree" title="Recebido de graça">
                  <RailIcon>
                    <path d="M12 7v14"></path>
                    <path d="M20 11v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8"></path>
                    <path d="M7.5 7a1 1 0 0 1 0-5A4.8 8 0 0 1 12 7a4.8 8 0 0 1 4.5-5 1 1 0 0 1 0 5"></path>
                    <rect x="3" y="7" width="18" height="4" rx="1"></rect>
                  </RailIcon>
                  <span class="sidebar-reveal">
                    <span class="sidebar-reveal-inner field">
                      <span class="field-label">Recebido de graça</span>
                      <div class="seg-control" role="group" aria-label="Recebido de graça">
                        <button type="button" class="seg-btn" data-tri-filter="receivedForFree" data-tri-value="all" aria-pressed="true">Todos</button>
                        <button type="button" class="seg-btn" data-tri-filter="receivedForFree" data-tri-value="yes" aria-pressed="false">Sim</button>
                        <button type="button" class="seg-btn" data-tri-filter="receivedForFree" data-tri-value="no" aria-pressed="false">Não</button>
                      </div>
                    </span>
                  </span>
                </div>

                <div class="sidebar-row is-field" data-filter-row="earlyAccess" title="Acesso antecipado">
                  <RailIcon>
                    <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path>
                    <path
                      d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09"
                    ></path>
                    <path
                      d="M9 12a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.4 22.4 0 0 1-4 2z"
                    ></path>
                    <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 .05 5 .05"></path>
                  </RailIcon>
                  <span class="sidebar-reveal">
                    <span class="sidebar-reveal-inner field">
                      <span class="field-label">Acesso antecipado</span>
                      <div class="seg-control" role="group" aria-label="Acesso antecipado">
                        <button type="button" class="seg-btn" data-tri-filter="earlyAccess" data-tri-value="all" aria-pressed="true">Todos</button>
                        <button type="button" class="seg-btn" data-tri-filter="earlyAccess" data-tri-value="yes" aria-pressed="false">Sim</button>
                        <button type="button" class="seg-btn" data-tri-filter="earlyAccess" data-tri-value="no" aria-pressed="false">Não</button>
                      </div>
                    </span>
                  </span>
                </div>
              </div>
            </form>
          <button id="clear-filters" type="button" class="sidebar-row clear-row mt-4" title="Limpar filtros">
            <RailIcon>
              <path
                d="M21 21H8a2 2 0 0 1-1.42-.587l-3.994-3.999a2 2 0 0 1 0-2.828l10-10a2 2 0 0 1 2.829 0l5.999 6a2 2 0 0 1 0 2.828L12.834 21"
              ></path>
              <path d="m5.082 11.09 8.828 8.828"></path>
            </RailIcon>
            <span class="sidebar-reveal">
              <span class="sidebar-reveal-inner">Limpar filtros</span>
            </span>
          </button>
          <p id="filter-summary" class="sidebar-summary meta mt-2" aria-live="polite">Nenhum filtro ativo</p>
        </div>
      </div>
    </aside>

    <main id="dashboard-main" class="min-w-0 flex-1" aria-busy="true">
      <div class="stage mx-auto flex w-full max-w-[1320px] flex-col gap-8 px-6 py-6">
        <header id="context-bar" class="context-bar" aria-label="Recorte ativo">
          <div class="context-top">
            <div class="context-heading">
              <h2 class="title">Painel de avaliações</h2>
              <p id="context-subtitle" class="meta">1.000.000 de avaliações · 59 jogos · mar/2013 a&#160;jan/2021</p>
            </div>
            <div id="active-chips" class="active-chips" aria-live="polite"></div>
          </div>
          <div id="thesis-presets" class="preset-bar" role="group" aria-label="Recortes guiados da análise">
            <span class="meta">Recortes do estudo:</span>
            <button type="button" class="preset-btn" data-preset="refund" aria-pressed="false" title="Filtrar avaliações na primeira hora de jogo (< 1 h: 49,6% de aprovação)">Janela &lt; 1&#160;h</button>
            <button type="button" class="preset-btn" data-preset="early" aria-pressed="false" title="Filtrar avaliações em Acesso Antecipado (69,8% vs. 83,8% fora dele)">Acesso&#160;antecipado</button>
            <button type="button" class="preset-btn" data-preset="dissatisfaction" aria-pressed="false" title="Filtrar avaliações negativas (recebem 2,8x mais votos úteis)">Economia da&#160;insatisfação</button>
          </div>
        </header>

        <div id="load-error" role="alert" hidden class="card">
          <p>Não foi possível carregar os dados.</p>
          <p id="load-error-detail" class="meta mt-1">Verifique se a API local está ativa em http://127.0.0.1:8000.</p>
          <button id="retry" type="button" class="btn btn-primary mt-4">Tentar de novo</button>
        </div>

        <section class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label="Indicadores">
          <article class="card flex flex-col gap-3">
            <p class="meta">Avaliações</p>
            <p id="metric-reviews" class="figure">—</p>
            <p id="metric-reviews-sub" class="meta">100% da base&#160;auditada</p>
          </article>

          <article class="card flex flex-col gap-3">
            <p class="meta">Recomendação</p>
            <div class="relative">
              <p id="metric-recommendation" class="figure is-accent">—</p>
              <span class="stamp-rule" aria-hidden="true"></span>
            </div>
            <p id="metric-recommendation-sub" class="meta">média global da&#160;base</p>
          </article>

          <article class="card flex flex-col gap-3">
            <p class="meta">Jogos</p>
            <p id="metric-games" class="figure">—</p>
            <p id="metric-games-sub" class="meta">de 59 no&#160;catálogo</p>
          </article>

          <article class="card flex flex-col gap-3">
            <p class="meta">Autores</p>
            <p id="metric-authors" class="figure">—</p>
            <p id="metric-authors-sub" class="meta">de 912.553&#160;contas</p>
          </article>
        </section>

        <section class="grid grid-cols-1 gap-4 lg:grid-cols-3" aria-label="Gráficos">
          <article class="card lg:col-span-2">
            <h2 class="title">Avaliações por mês</h2>
            <p class="meta mt-2">Publicadas em cada mês do recorte</p>
            <div id="chart-month" class="mt-4 h-[320px] w-full"></div>
            <p id="chart-month-empty" class="meta mt-4" hidden>Nenhum mês no recorte.</p>
          </article>

          <article class="card">
            <h2 class="title">Volume por jogo</h2>
            <p class="meta mt-2">Jogos com mais avaliações · clique para&#160;filtrar</p>
            <ol id="rank-games" class="rank-list"></ol>
          </article>

          <article class="card lg:col-span-2">
            <h2 class="title">Recomendação por tempo de jogo</h2>
            <p class="meta mt-2">Aprovação por faixa (reembolso até 2&#160;h) · clique para&#160;filtrar</p>
            <div id="chart-playtime" class="mt-4 h-[280px] w-full"></div>
            <p id="chart-playtime-empty" class="meta mt-4" hidden>Nenhuma faixa no recorte.</p>
          </article>

          <article class="card">
            <h2 class="title">Aprovação por idioma</h2>
            <p class="meta mt-2">Top idiomas por volume, ordenados pela aprovação · clique para&#160;filtrar</p>
            <ol id="rank-languages" class="rank-list"></ol>
          </article>
        </section>

        <section class="flex flex-col gap-4" aria-labelledby="reviews-heading">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 id="reviews-heading" class="title">Avaliações</h2>
            <p class="meta">Clique ou pressione Enter em uma linha para expandir&#160;detalhes</p>
          </div>
          <div class="sheet">
            <table>
              <caption class="sr-only">Avaliações da seleção atual</caption>
              <thead>
                <tr>
                  <th scope="col" class="w-[16%]">Jogo</th>
                  <th scope="col" class="w-[12%]">Idioma</th>
                  <th scope="col" class="w-[10%]">Recomendação</th>
                  <th scope="col" class="w-[9%]">Horas</th>
                  <th scope="col" class="w-[9%]">Votos úteis</th>
                  <th scope="col" class="w-[44%]">Trecho</th>
                </tr>
              </thead>
              <tbody id="reviews-body"></tbody>
            </table>
          </div>
          <nav class="flex flex-wrap items-center justify-between gap-3" aria-label="Paginação">
            <p id="page-range" class="meta font-mono tabular-nums">—</p>
            <div class="flex gap-2">
              <button id="page-prev" type="button" class="btn btn-secondary btn-small" disabled>Anterior</button>
              <button id="page-next" type="button" class="btn btn-secondary btn-small" disabled>Próxima</button>
            </div>
          </nav>
          <p class="meta">Base higienizada: partição 1:1 das 4 tabelas do Kaggle · underflow uint32 corrigido em votos engraçados · resumo truncado em 280&#160;caracteres.</p>
        </section>
      </div>
    </main>
  </div>

  <script>
    import '../scripts/dashboard';
  </script>
</Base>

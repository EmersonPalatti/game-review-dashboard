---
import Base from '../layouts/Base.astro';
import MobileBar from '../components/MobileBar.astro';
import Sidebar from '../components/Sidebar.astro';
import ContextBar from '../components/ContextBar.astro';
import { ChartsIsland } from '../components/react/ChartsIsland';
import { MetricsIsland } from '../components/react/MetricsIsland';
import { ReviewsIsland } from '../components/react/ReviewsIsland';
---

<Base>
  <div class="flex min-h-screen w-full flex-col md:flex-row">
    <MobileBar />
    <Sidebar />

    <main id="dashboard-main" class="min-w-0 flex-1">
      <div class="stage mx-auto flex w-full max-w-[1320px] flex-col gap-8 px-6 py-6">
        <ContextBar />

        <div id="load-error" role="alert" aria-hidden="true" hidden class="card">
          <p class="title">Não foi possível conectar à API de avaliações.</p>
          <p id="load-error-detail" class="meta mt-1">Verifique se o servidor FastAPI está ativo em http://127.0.0.1:8000 e tente novamente.</p>
          <button id="retry" type="button" class="btn btn-primary mt-4">Tentar de novo</button>
        </div>

        <MetricsIsland client:load />

        <ChartsIsland client:visible />

        <ReviewsIsland client:visible />
      </div>
    </main>
  </div>

  <script>
    import '../scripts/dashboard';
  </script>
</Base>

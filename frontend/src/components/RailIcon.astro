---
import type { IconNode } from 'lucide';

interface Props {
  icon?: IconNode;
  class?: string;
}

const { icon, class: className = 'sidebar-icon' } = Astro.props;

const renderIconNode = (nodes: IconNode): string =>
  nodes
    .map(([tag, attrs]) => {
      const attrStr = Object.entries(attrs)
        .filter(([k, v]) => k !== 'key' && v !== undefined)
        .map(([k, v]) => `${k}="${String(v)}"`)
        .join(' ');
      return `<${tag} ${attrStr}></${tag}>`;
    })
    .join('');
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {icon ? <Fragment set:html={renderIconNode(icon)} /> : <slot />}
</svg>

---
import { BASELINE_PERIOD_SHORT } from '../lib/constants';
import { ContextIsland } from './react/ContextIsland';
---

<header id="context-bar" class="context-bar" aria-label="Recorte ativo">
  <div class="context-top">
    <div class="context-heading">
      <h2 class="title">Painel de avaliações</h2>
      <p id="context-subtitle" class="meta" aria-live="polite">1.000.000 de avaliações · 59 jogos · {BASELINE_PERIOD_SHORT}</p>
    </div>
    <ContextIsland client:load />
  </div>
</header>

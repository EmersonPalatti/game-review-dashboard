---
import { Menu } from 'lucide';
import { BASELINE_PERIOD_SHORT } from '../lib/constants';
import RailIcon from './RailIcon.astro';
---

<div class="sidebar-mobile-bar">
  <div class="mobile-title">
    <span class="mobile-wordmark">Reviews da Steam</span>
    <span class="meta mobile-period">{BASELINE_PERIOD_SHORT}</span>
  </div>
  <button
    id="sidebar-open"
    type="button"
    class="sidebar-burger"
    aria-expanded="false"
    aria-controls="app-sidebar"
    aria-label="Mostrar filtros"
  >
    <RailIcon icon={Menu} />
  </button>
</div>

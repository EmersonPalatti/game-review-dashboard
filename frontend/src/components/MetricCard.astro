---
interface Props {
  id: 'reviews' | 'recommendation' | 'games' | 'authors';
  label: string;
  defaultSub: string;
  accent?: boolean;
}

const { id, label, defaultSub, accent = false } = Astro.props;
---

<article class="card flex flex-col gap-3">
  <p class="meta">{label}</p>
  {
    accent ? (
      <div class="relative">
        <p id={`metric-${id}`} class="figure is-accent">—</p>
        <span class="stamp-rule" aria-hidden="true"></span>
      </div>
    ) : (
      <p id={`metric-${id}`} class="figure">—</p>
    )
  }
  <p id={`metric-${id}-sub`} class="meta">{defaultSub}</p>
</article>

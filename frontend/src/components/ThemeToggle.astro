---
import { Sun, Moon } from 'lucide';
import RailIcon from './RailIcon.astro';
---

<button
  id="theme-toggle"
  type="button"
  class="theme-switch"
  aria-label="Mudar para tema escuro"
  title="Mudar para tema escuro"
>
  <span class="when-light"><RailIcon icon={Moon} /></span>
  <span class="when-dark"><RailIcon icon={Sun} /></span>
  <span class="sr-only"><span class="when-light">Tema escuro</span><span class="when-dark">Tema claro</span></span>
</button>

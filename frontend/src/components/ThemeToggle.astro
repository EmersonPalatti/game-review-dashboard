---
import { Sun, Moon } from 'lucide';
import RailIcon from './RailIcon.astro';
---

<button
  id="theme-toggle"
  type="button"
  class="sidebar-row theme-toggle"
  aria-label="Mudar para tema escuro"
>
  <span class="when-light">
    <RailIcon icon={Moon} />
  </span>
  <span class="when-dark">
    <RailIcon icon={Sun} />
  </span>
  <span class="sidebar-reveal">
    <span class="sidebar-reveal-inner">
      <span class="when-light">Tema escuro</span>
      <span class="when-dark">Tema claro</span>
    </span>
  </span>
</button>
